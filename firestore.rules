rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isMaster() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "master";
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Revisa si al usuario ya se le vencio el acceso: primero su fecha individual;
    // si no tiene, la del ciclo al que pertenece; si no tiene ninguna, sin limite.
    function hasActiveAccess() {
      let u = myProfile();
      let individualEnd = u.get("enrollmentEndDate", null);
      let cycleIdVal = u.get("cycleId", null);
      let hasCycle = cycleIdVal != null && cycleIdVal != "" && exists(/databases/$(database)/documents/studyCycles/$(cycleIdVal));
      let cycleEnd = hasCycle ? get(/databases/$(database)/documents/studyCycles/$(cycleIdVal)).data.get("endDate", null) : null;
      let effectiveEnd = individualEnd != null ? individualEnd : cycleEnd;
      return effectiveEnd == null || request.time <= effectiveEnd;
    }

    // Contenido de las unidades: lectura para cualquier usuario con sesion.
    // (La fecha de vencimiento se revisa al guardar progreso, no aqui —
    // revisarla aqui tambien, unidad por unidad, puede chocar con el limite
    // de Firestore de consultas cruzadas quando se leen muchas unidades de una vez.)
    // Nadie escribe desde el navegador — solo el script de carga.
    match /units/{unitId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Perfil de cada usuario (rol + niveles habilitados):
    // - Cualquiera puede leer SU PROPIO perfil (para saber su rol y que niveles ve).
    // - El master puede leer el perfil de cualquiera (para el panel).
    // - SOLO el master puede escribir/editar perfiles — un estudiante nunca puede
    //   auto-asignarse el rol de master ni habilitarse niveles el mismo.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isMaster());
      // El master puede escribir cualquier cosa. Un estudiante puede actualizar su
      // propio documento (ej. totalMinutes, currentPassword) SIEMPRE Y CUANDO no
      // toque su propio rol ni su nivel — asi nunca puede auto-asignarse mas acceso.
      allow write: if isMaster() ||
        (request.auth != null && request.auth.uid == userId &&
         request.resource.data.get("role", "") == resource.data.get("role", "") &&
         request.resource.data.get("level", null) == resource.data.get("level", null));
    }

    // Progreso de cada estudiante (incluye el texto del writing):
    // - El propio estudiante lee/escribe su progreso.
    // - El master puede leer/borrar el de cualquiera (para el panel de revision y eliminar cuentas).
    match /users/{userId}/progress/{unitId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isMaster());
      allow write: if request.auth != null && request.auth.uid == userId && hasActiveAccess();
      allow delete: if isMaster();
    }

    // Historial de cambios del panel (crear/borrar estudiantes, cambiar nivel):
    // solo el master lo puede leer o escribir.
    match /changelog/{entryId} {
      allow read, write: if isMaster();
    }

    // Reportes de problemas que envian los estudiantes:
    // cualquier usuario con sesion puede crear uno (nunca editarlo despues),
    // solo el master los puede leer.
    match /supportReports/{reportId} {
      allow create: if request.auth != null;
      allow read: if isMaster();
      allow update, delete: if false;
    }

    // Ciclos de estudio (fechas de inicio/fin de cada clase):
    // el master puede todo. Un estudiante puede leer SOLO el ciclo al que el
    // mismo pertenece (para saber si ya vencio), nada mas.
    match /studyCycles/{cycleId} {
      allow read: if isMaster() || (request.auth != null && myProfile().get("cycleId", null) == cycleId);
      allow write: if isMaster();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
