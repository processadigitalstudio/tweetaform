{
  "unit_id": "A1-04",
  "level": "A1",
  "title": "Crime",
  "grammar_topic": "Be: short answers; this/that/these/those",
  "vocab_theme": "Crimen, policía, situaciones legales básicas",
  "can_do": "Puede responder preguntas simples, identificar objetos y hablar de situaciones relacionadas con delitos",
  "grammar_explanation": {
    "language": "es",
    "core_rule": "Las respuestas cortas con 'to be' repiten el verbo, no toda la oración ('Are you a witness? Yes, I am.'). Los demostrativos this/that/these/those señalan objetos: this/these para algo cerca, that/those para algo lejos; this/that son singulares, these/those son plurales.",
    "structure_notes": [
      {
        "label": "Respuestas cortas afirmativas",
        "explanation": "Yes, + sujeto + am/is/are.",
        "example": "Is this your wallet? Yes, it is."
      },
      {
        "label": "Respuestas cortas negativas",
        "explanation": "No, + sujeto + am not/isn't/aren't.",
        "example": "Are you a witness? No, I'm not."
      },
      {
        "label": "this / that (singular)",
        "explanation": "'this' para algo cerca, 'that' para algo lejos.",
        "example": "This is my ID. That is the police station."
      },
      {
        "label": "these / those (plural)",
        "explanation": "'these' para varios cerca, 'those' para varios lejos.",
        "example": "These are my keys. Those are the suspects."
      }
    ],
    "examples": [
      "Is this your wallet? Yes, it is.",
      "Are you a witness? No, I'm not.",
      "This is a police officer.",
      "Those are stolen bikes."
    ],
    "common_mistake": "Usar 'this/that' con sustantivos plurales — 'this bikes' es incorrecto, debe ser 'these bikes'."
  },
