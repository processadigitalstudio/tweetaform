  "reading": [
    {
      "title": "A Visit to the Museum",
      "word_count": 93,
      "text": "Yesterday, my class visited the city's art museum. There is a new exhibition of paintings from local artists. Our teacher says the artist is very talented and famous in Colombia. One painting is very big and colorful. Is it popular? Yes, it is! Many people take photos next to it. My friend Sara is an art student, and she loves this museum. She says she wants to be an artist too. The museum isn't far from our school, so we walk there every year. It's one of my favorite places to visit.",
      "questions": [
        { "q": "What did the class visit?", "type": "mcq", "options": ["A concert", "A museum", "A movie theater", "A restaurant"], "answer": "A museum" },
        { "q": "Is the artist famous?", "type": "true_false", "answer": true },
        { "q": "Who wants to be an artist?", "type": "mcq", "options": ["The teacher", "Sara", "The writer", "Nobody"], "answer": "Sara" },
        { "q": "Is the museum far from the school?", "type": "true_false", "answer": false },
        { "q": "___ this painting popular? (completa)", "type": "fill_blank", "answer": "Is" }
      ]
    },
    {
      "title": "My Favorite Band",
      "word_count": 89,
      "text": "My favorite band is called Luna Nueva. They're from Barranquilla, and they're very talented. Their songs are popular all over Colombia. I'm a big fan, and I have all their music. Last month, they performed at a big concert in my city. It wasn't cheap, but it was worth it! The singer is famous, but she's very humble too. My sister isn't a fan of their music, but she came with me anyway. It was an amazing night, and I hope they perform here again soon.",
      "questions": [
        { "q": "Where is the band from?", "type": "mcq", "options": ["Cartagena", "Barranquilla", "Bogotá", "Sincelejo"], "answer": "Barranquilla" },
        { "q": "Are the band's songs popular?", "type": "true_false", "answer": true },
        { "q": "Is the singer humble?", "type": "true_false", "answer": true },
        { "q": "Is the writer's sister a fan of the band?", "type": "mcq", "options": ["Yes, a big fan", "No, but she went anyway", "She's the singer", "She doesn't know them"], "answer": "No, but she went anyway" },
        { "q": "They're ___ Barranquilla. (completa la preposición)", "type": "fill_blank", "answer": "from" }
      ]
    }
