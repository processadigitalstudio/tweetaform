{
  "unit_id": "A1-05",
  "level": "A1",
  "title": "Art",
  "grammar_topic": "Verb to be: afirmativo, Yes/No questions y contractions",
  "vocab_theme": "Arte, música, entretenimiento",
  "can_do": "Puede describir personas/situaciones sencillas y hablar de entretenimiento",

  "grammar_explanation": {
    "language": "es",
    "core_rule": "Las contracciones combinan el pronombre y el verbo 'to be' en una sola palabra (I am → I'm). Las preguntas Yes/No con 'to be' invierten el orden: el verbo va antes del sujeto.",
    "structure_notes": [
      { "label": "Contracciones afirmativas", "explanation": "I'm, you're, he's, she's, it's, we're, they're.", "example": "She's a painter." },
      { "label": "Contracciones negativas", "explanation": "isn't, aren't ('am not' no se contrae, se dice 'I'm not').", "example": "They're not musicians. / They aren't musicians." },
      { "label": "Preguntas Yes/No", "explanation": "Verbo + sujeto + resto de la oración.", "example": "Is she an artist? Are they musicians?" }
    ],
    "examples": [
      "She's a painter.",
      "They're not musicians.",
      "Is this song popular?",
      "Are you an art student?"
    ],
    "common_mistake": "Intentar contraer 'am not' como 'amn't' — esa forma no existe, se dice 'I'm not'."
  },

  "grammar_practice": [
    { "type": "fill_blank", "q": "She ___ a painter. (contracción de 'is')", "answer": "'s" },
    { "type": "fill_blank", "q": "They ___ musicians. (contracción de 'are')", "answer": "'re" },
    { "type": "fill_blank", "q": "I ___ an art student. (contracción de 'am')", "answer": "'m" },
    { "type": "fill_blank", "q": "___ she an artist? (pregunta)", "answer": "Is" },
    { "type": "fill_blank", "q": "___ they musicians? (pregunta)", "answer": "Are" },
    { "type": "fill_blank", "q": "He ___ not a singer. (contracción negativa de 'is not')", "answer": "isn't" },
    { "type": "fill_blank", "q": "We ___ not at the concert. (contracción negativa de 'are not')", "answer": "aren't" },
    { "type": "fill_blank", "q": "___ this movie popular? (pregunta)", "answer": "Is" },
    { "type": "fill_blank", "q": "It ___ a famous painting. (contracción de 'is')", "answer": "'s" },
    { "type": "fill_blank", "q": "___ you an actor? (pregunta)", "answer": "Are" },
    { "type": "mcq", "q": "_____ a talented artist.", "options": ["She's", "She are", "She am"], "answer": "She's" },
    { "type": "mcq", "q": "_____ this song popular?", "options": ["Is", "Are", "Am"], "answer": "Is" },
    { "type": "mcq", "q": "_____ musicians in a famous band.", "options": ["They're", "They's", "They am"], "answer": "They're" },
    { "type": "mcq", "q": "_____ you an art student?", "options": ["Is", "Are", "Am"], "answer": "Are" },
    { "type": "mcq", "q": "He _____ a singer, he's an actor.", "options": ["isn't", "aren't", "amn't"], "answer": "isn't" },
    { "type": "mcq", "q": "_____ not at the museum today.", "options": ["We're", "We aren't", "We isn't"], "answer": "We aren't" },
    { "type": "true_false", "q": "'Amn't' is a correct contraction of 'am not'.", "answer": false },
    { "type": "true_false", "q": "'She's' can mean 'she is' or 'she has'.", "answer": true },
    { "type": "matching", "q": "Empareja la forma completa con su contracción", "pairs": [
      { "left": "she is", "right": "she's" },
      { "left": "they are", "right": "they're" },
      { "left": "is not", "right": "isn't" }
    ]},
    { "type": "order_words", "q": "Ordena la oración:", "words": ["popular?", "this", "Is", "song"], "answer": "Is this song popular?" }
  ],

