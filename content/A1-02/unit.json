  "reading": [
    {
      "title": "Going to School by Bus",
      "word_count": 93,
      "text": "Every morning, Julian takes the bus to school. He waits for it at the corner near his house. The bus driver is very kind, and he always says hello to him. Today, there are many passengers on the bus, and there is a lot of traffic. Julian looks out the window and sees his friend Marta. She is riding her bicycle. He waves at her. The bus arrives at school at 7:30. Julian is never late because his bus is always on time. He likes taking the bus with his classmates every day.",
      "questions": [
        {
          "q": "How does Julian go to school?",
          "type": "mcq",
          "options": [
            "By car",
            "By bus",
            "By bicycle",
            "By taxi"
          ],
          "answer": "By bus"
        },
        {
          "q": "Is the bus driver kind?",
          "type": "true_false",
          "answer": true
        },
        {
          "q": "What does Julian see out the window?",
          "type": "mcq",
          "options": [
            "A taxi",
            "His friend on a bicycle",
            "A train",
            "His house"
          ],
          "answer": "His friend on a bicycle"
        },
        {
          "q": "What time does the bus arrive at school?",
          "type": "mcq",
          "options": [
            "7:00",
            "7:30",
            "8:00",
            "8:30"
          ],
          "answer": "7:30"
        },
        {
          "q": "Is Julian usually late?",
          "type": "true_false",
          "answer": false
        }
      ]
    },
    {
      "title": "My Sister's Bicycle",
      "word_count": 88,
      "text": "My sister Valentina has a new bicycle. It is blue and very fast. She rides it to work every day because there is always a lot of traffic in our city. I usually take the bus, but sometimes I take a taxi if I am late. Valentina says her bicycle is better than a car because she never waits in traffic. Our father drives his car to work, and he says he wants a bicycle too. Maybe next year we will all ride bicycles together on the weekend.",
      "questions": [
        {
          "q": "What color is Valentina's bicycle?",
          "type": "mcq",
          "options": [
            "Red",
            "Blue",
            "Black",
            "Green"
          ],
          "answer": "Blue"
        },
        {
          "q": "Why does Valentina prefer her bicycle?",
          "type": "mcq",
          "options": [
            "It's cheaper",
            "She never waits in traffic",
            "It's a gift",
            "She doesn't like buses"
          ],
          "answer": "She never waits in traffic"
        },
        {
          "q": "How does the writer usually travel?",
          "type": "mcq",
          "options": [
            "By bicycle",
            "By bus",
            "By train",
            "By taxi"
          ],
          "answer": "By bus"
        },
        {
          "q": "Does their father want a bicycle too?",
          "type": "true_false",
          "answer": true
        },
