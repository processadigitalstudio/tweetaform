  "title": "Transportation",
  "grammar_topic": "Subject, object y possessive pronouns",
  "vocab_theme": "Transporte y desplazamientos",
  "can_do": "Puede hablar de personas y objetos y desenvolverse en transporte",
  "grammar_explanation": {
    "language": "es",
    "core_rule": "Los pronombres cambian de forma según su función en la oración: sujeto (quién hace la acción), objeto (quién recibe la acción), y posesivo (de quién es algo).",
    "structure_notes": [
      {
        "label": "Pronombres de sujeto",
        "explanation": "I, you, he, she, it, we, they — van antes del verbo.",
        "example": "She takes the bus every morning."
      },
      {
        "label": "Pronombres de objeto",
        "explanation": "me, you, him, her, it, us, them — van después del verbo o de una preposición.",
        "example": "The driver helps her with the bags."
      },
      {
        "label": "Adjetivos posesivos",
        "explanation": "my, your, his, her, its, our, their — van antes de un sustantivo.",
        "example": "This is my bicycle."
      }
    ],
    "examples": [
      "He drives to work every day.",
      "Can you help me, please?",
      "This is her bicycle.",
      "We take our bags with us."
    ],
    "common_mistake": "Confundir 'his' y 'her' — muchos hispanohablantes usan 'his' para todo. 'His' es de él, 'her' es de ella, sin importar el género del objeto."
  },
