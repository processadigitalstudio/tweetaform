  "unit_id": "A1-03",
  "level": "A1",
  "title": "Restaurants",
  "grammar_topic": "Singular/plural nouns; there is/there are; artículos",
  "vocab_theme": "Restaurantes, comida, biblioteca/estudios",
  "can_do": "Puede describir lo que hay en un lugar y hablar de comida/restaurantes",
  "grammar_explanation": {
    "language": "es",
    "core_rule": "Usamos 'there is' con sustantivos singulares y 'there are' con plurales para decir que algo existe en un lugar. Los artículos 'a/an' se usan para algo no específico, 'the' para algo específico ya mencionado o conocido.",
    "structure_notes": [
      {
        "label": "there is + singular",
        "explanation": "Para un solo objeto o persona.",
        "example": "There is a table by the window."
      },
      {
        "label": "there are + plural",
        "explanation": "Para varios objetos o personas.",
        "example": "There are three chairs here."
      },
      {
        "label": "a / an",
        "explanation": "'a' antes de sonido consonante, 'an' antes de sonido vocal.",
        "example": "I would like an orange juice and a sandwich."
      },
      {
        "label": "plural de sustantivos",
        "explanation": "Se agrega -s a la mayoría de sustantivos.",
        "example": "table → tables, dish → dishes"
      }
    ],
    "examples": [
      "There is a menu on the table.",
      "There are two waiters today.",
      "I would like an orange juice.",
      "The restaurant is very popular."
    ],
    "common_mistake": "Usar 'there is' con sustantivos plurales: 'there is two tables' es incorrecto — debe ser 'there are two tables'."
  },
